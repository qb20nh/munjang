{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "base_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewed_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "unit_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "error",
              "improvement",
              "preference"
            ]
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "suggestion": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "unit_ids",
          "severity",
          "category",
          "evidence",
          "reason",
          "suggestion"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "base_sha256",
    "reviewed_ids",
    "issues"
  ],
  "additionalProperties": false
}
