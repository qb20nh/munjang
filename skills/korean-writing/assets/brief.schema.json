{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "copyedit",
        "restructure",
        "draft"
      ]
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "genre": {
      "type": "string",
      "enum": [
        "general",
        "explanatory",
        "argument",
        "business",
        "essay",
        "fiction",
        "technical",
        "social"
      ]
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "tone": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string"
    },
    "protected_strings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "semantic_invariants": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_points": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "style_samples": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "quote_policy": {
      "type": "string",
      "enum": [
        "protect",
        "review"
      ]
    },
    "freeze_numbers": {
      "type": "boolean"
    },
    "max_rounds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "max_change_ratio": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "min_chars": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "max_chars": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "max_request_chars": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 1000000
    }
  },
  "additionalProperties": false
}
