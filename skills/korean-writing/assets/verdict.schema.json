{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "base_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidate_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "decision": {
      "type": "string",
      "enum": [
        "accept",
        "reject",
        "needs_review"
      ]
    },
    "reviewed_original_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "reviewed_candidate_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "meaning",
              "entities_roles",
              "negation_conditions",
              "modality_scope",
              "tense_aspect",
              "numbers_bindings",
              "causality_attribution",
              "required_information",
              "voice_genre",
              "no_new_errors",
              "evidence_fidelity",
              "edit_scope"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "uncertain"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "status",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "resolved_issue_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "unresolved_issue_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "new_issues": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "base_sha256",
    "candidate_sha256",
    "decision",
    "reviewed_original_ids",
    "reviewed_candidate_ids",
    "checks",
    "resolved_issue_ids",
    "unresolved_issue_ids",
    "new_issues",
    "reason"
  ],
  "additionalProperties": false
}
